.picker { padding: 20rpx; background: #f5f7fa; border-radius: 12rpx; margin-bottom: 20rpx; }
textarea { width: 100%; height: 240rpx; background: #f5f7fa; padding: 20rpx; border-radius: 12rpx; box-sizing: border-box; }
.btn-primary { margin-top: 32rpx; }

.section { margin-top: 30rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; padding-left: 10rpx; }

.loading, .empty { text-align: center; color: #999; padding: 40rpx; }

.feedback-list { display: flex; flex-direction: column; gap: 20rpx; }

.feedback-item { padding: 24rpx; }

.feedback-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }

.feedback-header .type { font-size: 28rpx; color: #666; }

.feedback-header .status { font-size: 26rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }

.feedback-header .status.orange { background: #fff3e8; color: #f60; }

.feedback-header .status.blue { background: #e8f4fd; color: #1890ff; }

.feedback-header .status.green { background: #e8f8e8; color: #52c41a; }

.feedback-header .status.gray { background: #f5f5f5; color: #999; }

.feedback-desc { font-size: 28rpx; color: #333; line-height: 1.6; margin-bottom: 16rpx; }

.feedback-reply { background: #f8f9fa; padding: 16rpx; border-radius: 8rpx; margin-bottom: 16rpx; }

.feedback-reply .reply-label { font-size: 26rpx; color: #999; margin-bottom: 8rpx; }

.feedback-reply .reply-content { font-size: 28rpx; color: #1890ff; }

.feedback-time { font-size: 24rpx; color: #999; }

.feedback-resolve-time { font-size: 24rpx; color: #999; margin-top: 8rpx; }
