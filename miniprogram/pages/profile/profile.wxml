<protocol-modal show="{{showProtocol}}" bind:agree="onProtocolAgree" bind:reject="onProtocolReject" />

<view class="container">
  <view class="card user-card" bindtap="handleLogin">
    <image class="avatar" src="{{user.avatar || 'https://thirdwx.qlogo.cn/mmopen/vi_32/default.png'}}" />
    <view class="user-meta">
      <text class="nickname">{{user.nickname || '未登录'}}</text>
      <text class="login-hint" wx:if="{{!loggedIn}}">点击头像或昵称登录</text>
    </view>
  </view>
  <view class="card menu-item" bindtap="goFavorites">我的收藏</view>
  <view class="card menu-item" bindtap="goBrowseHistory">浏览记录</view>
  <view class="card menu-item" bindtap="goMessages">
    消息中心
    <text class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
  </view>
  <view class="card menu-item" bindtap="goMyReviews">我的评价</view>
  <view class="card menu-item" bindtap="goFeedback">意见反馈</view>
  <view class="card menu-item" bindtap="goForum">餐饮论坛</view>
  <view class="card menu-item protocol-link" bindtap="goProtocol">用户协议与隐私政策</view>
  <button class="logout" wx:if="{{loggedIn}}" bindtap="logout">退出登录</button>
</view>
