<view class="state-box" wx:if="{{loading}}">
  <text class="text-muted">加载中...</text>
</view>
<view class="state-box" wx:elif="{{loadError}}">
  <text class="error-text">{{loadError}}</text>
  <button size="mini" type="primary" bindtap="retryLoad">重试</button>
</view>
<view class="container" wx:elif="{{dish}}">
  <swiper class="banner" indicator-dots wx:if="{{dish.images.length}}">
    <swiper-item wx:for="{{dish.images}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="banner-img" />
    </swiper-item>
  </swiper>
  <view class="banner banner-placeholder" wx:else>
    <text class="text-muted">暂无图片</text>
  </view>
  <view class="card">
    <text class="title">{{dish.name}}</text>
    <view class="row">
      <text class="score">★ {{dish.avgScore}}</text>
      <text class="price">¥{{dish.price}}</text>
      <text class="text-muted">月售{{dish.saleCount}}</text>
    </view>
    <text class="text-muted">{{dish.shopName}} · {{dish.stallName}}</text>
    <text class="desc">{{dish.description}}</text>
  </view>
  <view class="actions">
    <button size="mini" bindtap="toggleFavorite">{{dish.favorited ? '已收藏' : '收藏'}}</button>
    <button size="mini" type="primary" bindtap="goReview">写评价</button>
  </view>
  <view class="card">
    <text class="section-title">用户评价</text>
    <view class="review-item" wx:for="{{dish.reviews}}" wx:key="reviewId">
      <view class="review-head">
        <text>{{item.userName}}</text>
        <text class="score">★ {{item.score}}</text>
      </view>
      <text>{{item.content}}</text>
      <view class="review-images" wx:if="{{item.images.length}}">
        <image
          wx:for="{{item.images}}" wx:for-item="img" wx:key="*this"
          class="review-img-thumb" src="{{img}}" mode="aspectFill"
          bindtap="previewReviewImage" data-url="{{img}}" data-urls="{{item.images}}"
        />
      </view>
      <view class="review-foot">
        <text class="text-muted">{{item.createTime}}</text>
        <text class="report-link" bindtap="goReport" data-id="{{item.reviewId}}">举报</text>
      </view>
    </view>
    <view wx:if="{{!dish.reviews.length}}" class="text-muted">暂无评价</view>
    <view wx:if="{{reviewLoading}}" class="load-tip">加载中...</view>
    <view wx:elif="{{!reviewHasMore && dish.reviews.length > 0}}" class="load-tip text-muted">— 已加载全部评价 —</view>
  </view>
</view>
